# Use a long random value in deployment. This default is for local assessment only.
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The default stores docspace.db in the backend project directory.
DATABASE_URL=sqlite:///./docspace.db
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=1048576
